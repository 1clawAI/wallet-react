{
  "name": "@1claw/wallet-react",
  "version": "0.5.2",
  "description": "Embeddable treasury wallet component for Platform API apps built on 1Claw",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs"
    },
    "./oauth": {
      "types": "./dist/SignInWith1Claw.d.ts",
      "import": "./dist/SignInWith1Claw.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/client.ts src/SignInWith1Claw.tsx --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/client.ts src/SignInWith1Claw.tsx --format cjs,esm --dts --watch",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/1clawAI/wallet-react.git"
  },
  "keywords": [
    "1claw",
    "wallet",
    "treasury",
    "react",
    "crypto",
    "embedded"
  ]
}
